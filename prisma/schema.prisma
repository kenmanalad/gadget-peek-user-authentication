

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UnverifiedUser {
  id Int @id @default(autoincrement())
  emailAddress String @unique
  password String
  createdAt DateTime @default(now())
  codeExpirationDate DateTime
  code Int @default(0)
  reset DateTime
}

model VerifiedUser {
  id Int @id @default(autoincrement())
  emailAddress String @unique
  password String?
  createdAt DateTime @default(now())
  role String @default("buyer")
  isActive Boolean @default(true)
  updateCode Int @default(0)
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id Int @id @default(autoincrement())
  userId Int
  verifiedUser VerifiedUser @relation(fields: [userId], references: [id])
  refreshToken String @unique
  expirationDate DateTime
  createdAt DateTime @default(now())
  browser String
  device String
  isValid Boolean @default(true)
  generatedBy String @default("local")
}

model ForgetPassword{
  id Int @id @default(autoincrement())
  emailAddress String
  code Int
  codeExpiration DateTime
  reset DateTime
}